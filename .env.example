POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

NODE_ENV=development
PORT=3000

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OTP
OTP_EXPIRES_IN_SECONDS=300
# Minimum gap between two verification-code resends for one email address
OTP_RESEND_COOLDOWN_SECONDS=60

# MAIL
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
# Absolute, publicly reachable URL of the InventoAI logo shown in owner emails
PLATFORM_LOGO_URL=

# Frontend base url
SITE_BASE_URL=http://localhost:4200

# CORS — comma-separated list of allowed browser origins (no trailing slash)
CORS_ORIGINS=http://localhost:4200

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
# Embeddings for the chatbot knowledge base. EMBEDDING_DIMENSIONS must match the
# vector(n) column KnowledgeVectorInitializer creates — changing it is a
# re-index, not a config tweak. 768 is a supported Matryoshka truncation and the
# largest pgvector can put under an HNSW index.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Storefront chatbot. CHATBOT_MODEL is separate from GEMINI_MODEL on purpose:
# chat wants cheap and fast and is called on every message, while the site
# builder wants the better model and is called rarely. On a free Gemini key that
# separation is what makes the assistant usable at all — the full flash models
# allow only ~20 generate calls per DAY, and one chat turn costs two or three.
CHATBOT_MODEL=gemini-3.1-flash-lite
CHATBOT_MAX_MESSAGES_PER_SESSION=40
CHATBOT_RATE_LIMIT_PER_MINUTE=10
CHATBOT_HISTORY_TURNS=8


# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=inventoai
