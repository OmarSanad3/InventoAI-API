POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

NODE_ENV=development
PORT=3000

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OTP
OTP_EXPIRES_IN_SECONDS=300
# Minimum gap between two verification-code resends for one email address
OTP_RESEND_COOLDOWN_SECONDS=60

# MAIL
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
# Absolute, publicly reachable URL of the InventoAI logo shown in owner emails
PLATFORM_LOGO_URL=

# Frontend base url
SITE_BASE_URL=http://localhost:4200

# CORS — comma-separated list of allowed browser origins (no trailing slash)
CORS_ORIGINS=http://localhost:4200

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
# Embeddings for the chatbot knowledge base. EMBEDDING_DIMENSIONS must match the
# vector(n) column KnowledgeVectorInitializer creates — changing it is a
# re-index, not a config tweak. 768 is a supported Matryoshka truncation and the
# largest pgvector can put under an HNSW index.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Storefront chatbot. CHATBOT_MODEL is separate from GEMINI_MODEL on purpose:
# chat wants cheap and fast and is called on every message, while the site
# builder wants the better model and is called rarely. On a free Gemini key that
# separation is what makes the assistant usable at all — the full flash models
# allow only ~20 generate calls per DAY, and one chat turn costs two or three.
CHATBOT_MODEL=gemini-3.1-flash-lite
CHATBOT_MAX_MESSAGES_PER_SESSION=40
CHATBOT_RATE_LIMIT_PER_MINUTE=10
CHATBOT_HISTORY_TURNS=8


# Daily AI Advisor. Open-Meteo needs no key and no signup; the URL is here so a
# test can point it at a stub. ADVISOR_DEFAULT_TIMEZONE is only the fallback for
# a store that has not set its own — every window the Advisor measures is in the
# store's local time, not the server's.
ADVISOR_WEATHER_BASE_URL=https://api.open-meteo.com/v1
ADVISOR_DEFAULT_TIMEZONE=Africa/Cairo
# Separate from GEMINI_MODEL for the same reason CHATBOT_MODEL is: the free tier
# allows ~20 generate calls per DAY on a full flash model and the site builder
# spends them, so a brief generated at 7am would always fall back to templates.
# The narrator only rewrites sentences it was handed — a lite model does it well.
ADVISOR_MODEL=gemini-3.1-flash-lite

# Google Sign-In — the OAuth 2.0 Web client id from the Google Cloud console.
# Identity only (openid email profile); no client secret is needed to verify an
# ID token, and none belongs here. The frontend renders the Google button with
# the same id and POSTs the credential to /users/google.
GOOGLE_CLIENT_ID=

# Supplier mail through the owner's own Gmail — the same Cloud client as above,
# plus the secret an authorization-code exchange needs. Leave all four blank and
# the feature is simply off: requests go out over SMTP and replies arrive by
# paste, which is a supported way to run this, not a degraded one.
#
# The scopes are gmail.send (sensitive) and gmail.readonly (RESTRICTED —
# verification plus an annual third-party security assessment before a public
# launch). In "testing" publishing status it works today with up to 100 hand-added
# test users, and refresh tokens that expire every 7 days.
#
# GOOGLE_MAILBOX_REDIRECT_URI must match a URI registered in the Cloud console
# exactly. It is a frontend screen, which POSTs the code to /mailbox/callback.
GOOGLE_CLIENT_SECRET=
GOOGLE_MAILBOX_REDIRECT_URI=http://localhost:4200/dashboard/mailbox/callback
GOOGLE_GMAIL_API_BASE_URL=https://gmail.googleapis.com/gmail/v1

# Encrypts the stored refresh tokens: 64 hex characters, i.e. `openssl rand -hex 32`.
# Rotating it makes every stored grant unreadable — those stores report `expired`
# and their owners reconnect. Leave it blank and the server refuses to ask for a
# grant it could not store safely.
MAILBOX_TOKEN_ENCRYPTION_KEY=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=inventoai
